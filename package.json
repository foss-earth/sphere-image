{
  "name": "@foss-earth/sphere-image",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/sphere-image.git"
  },
  "exports": {
    "./download": {
      "types": "./node/download.d.mts",
      "import": "./node/download.mjs"
    },
    "./download-cli": "./node/download-cli.mjs",
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babylon": {
      "source": "./src/renderer.ts",
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./shaders": {
      "source": "./src/shaders.ts",
      "types": "./dist/shaders.d.ts",
      "import": "./dist/shaders.js"
    },
    "./shaders-webgl": {
      "source": "./src/shadersWebGl.ts",
      "types": "./dist/shadersWebGl.d.ts",
      "import": "./dist/shadersWebGl.js"
    },
    "./input": {
      "source": "./src/browserInput.ts",
      "types": "./dist/browserInput.d.ts",
      "import": "./dist/browserInput.js"
    },
    "./viewer": {
      "source": "./src/viewer.ts",
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./settings": {
      "source": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./preparation": {
      "types": "./node/preparation.d.mts",
      "import": "./node/preparation.mjs"
    },
    "./prepare-cli": "./node/prepare-cli.mjs",
    "./resources": {
      "source": "./src/resources.ts",
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./panels": {
      "source": "./src/panels.ts",
      "types": "./dist/panels.d.ts",
      "import": "./dist/panels.js"
    },
    "./node": {
      "types": "./node/preparation.d.mts",
      "import": "./node/preparation.mjs"
    },
    "./globe": {
      "source": "./src/globeBindings.ts",
      "types": "./dist/globeBindings.d.ts",
      "import": "./dist/globeBindings.js"
    },
    "./globe-browser": {
      "source": "./src/globeBrowserBindings.ts",
      "types": "./dist/globeBrowserBindings.d.ts",
      "import": "./dist/globeBrowserBindings.js"
    },
    "./projections-TS": {
      "types": "./projections-TS/index.d.ts",
      "source": "./projections-TS/index.js",
      "import": "./projections-TS/index.js",
      "default": "./projections-TS/index.js"
    },
    "./projections-WASM": {
      "types": "./projections-WASM/index.d.ts",
      "source": "./projections-WASM/index.js",
      "import": "./projections-WASM/index.js",
      "default": "./projections-WASM/index.js"
    },
    "./projections-WASM/wasm": "./projections-WASM/single/projections.wasm"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md",
    "NOTICE",
    "node",
    "projections-TS",
    "projections-WASM",
    "docs",
    "fixtures/native-bindings",
    "AGENTS.md"
  ],
  "dependencies": {
    "@foss-earth/rectangle-image": "0.1.0",
    "@foss-earth/images": "0.1.0",
    "@foss-earth/sphere-cubemap": "0.1.0",
    "@foss-earth/sphere-equirectangular": "0.1.0",
    "@foss-earth/sphere-tiled-cubemap": "0.1.0",
    "@foss-earth/preview-sheets": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "@babylonjs/core": "8.56.2",
    "jsdom": "29.1.1",
    "@foss-earth/engine": "0.1.0",
    "@foss-earth/ui": "0.1.0",
    "@felipegalind0/gamepad-tools": "0.1.0",
    "@eslint/js": "9.39.4",
    "globals": "17.6.0",
    "@foss-earth/renderer": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "test:download": "node --test node/download.test.mjs",
    "ci": "npm run check:implementation",
    "typecheck:consumer": "tsc -p fixtures/tsconfig.json",
    "test:consumer": "node scripts/check-public-consumer.mjs",
    "build:wasm": "node projections-WASM/scripts/build.mjs",
    "check:wasm": "node projections-WASM/scripts/check.mjs",
    "check:parity": "node projections-WASM/scripts/check-projections.mjs --large",
    "test:wasm": "node --test projections-WASM/tests/*.test.mjs",
    "check:implementation": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:download && npm run typecheck:consumer"
  },
  "peerDependencies": {
    "@foss-earth/renderer": "0.1.0",
    "@foss-earth/ui": "0.1.0",
    "@babylonjs/core": "8.56.2",
    "@felipegalind0/gamepad-tools": "0.1.0",
    "@foss-earth/engine": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@foss-earth/renderer": {
      "optional": true
    },
    "@foss-earth/ui": {
      "optional": true
    },
    "@babylonjs/core": {
      "optional": true
    },
    "@felipegalind0/gamepad-tools": {
      "optional": true
    },
    "@foss-earth/engine": {
      "optional": true
    }
  },
  "description": "Image viewer composition and camera handover through explicit host ports",
  "bin": {
    "foss-earth-download-panorama": "./node/download-cli.mjs",
    "foss-earth-prepare-panorama": "./node/prepare-cli.mjs"
  }
}
